# Wake Environment Configuration Example
PORT=3000
NODE_ENV=development

# Ollama local inference host
OLLAMA_HOST=http://127.0.0.1:11434

# Open-weight model tag (default: gemma3:1b, fallback: qwen2.5-coder:1.5b)
WAKE_MODEL=gemma3:1b

# Maximum deaths to process per scan to cap memory and inference latency
MAX_DEATHS_CAP=50

# Optional Sentry Monitoring (Metadata only: latency, tokens, error counts - never code content)
# SENTRY_DSN=
